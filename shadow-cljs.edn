{:source-paths ["src" "test" "test-react19"]
 :dependencies [[com.taoensso/encore "3.168.0"]
                [com.taoensso/truss  "2.3.0"]
                [reagent             "2.0.1"]]
 :builds
 {:cljs-test
  {:target    :node-test
   :output-to "target/cljs-test.js"
   :ns-regexp "^taoensso\\.tengen-tests$"
   :compiler-options {:static-fns false}
   :autorun   true}

  :react19-test
  {:target    :node-test
   :output-to "target/react19-test.js"
   :ns-regexp "^taoensso\\.tengen-react19-tests$"
   :autorun   true}}}
